<Window x:Class="MeerkeuzeVragenApp.UI.Views.ImportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Importeren" Height="480" Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Data Importeren"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Importeer een vragenlijst uit een tekstbestand"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Formulier -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}"
                CornerRadius="10" Padding="20"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1">
            <StackPanel>

                <!-- Bestand -->
                <TextBlock Text="BESTAND" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtBestandspad" Grid.Column="0"
                             IsReadOnly="True" Height="38"
                             VerticalContentAlignment="Center"
                             Foreground="{StaticResource TextSecondary}"/>
                    <Button Grid.Column="1" Content="Bladeren"
                            Style="{StaticResource BtnSecondary}"
                            Padding="16,8" Margin="8,0,0,0"
                            Click="BtnBladeren_Click"/>
                </Grid>

                <!-- Onderwerp -->
                <TextBlock Text="ONDERWERP" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="TxtOnderwerp" Height="38"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,16"/>

                <!-- Moeilijkheidsgraad -->
                <TextBlock Text="MOEILIJKHEIDSGRAAD" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbMoeilijkheid">
                    <ComboBoxItem Content="Makkelijk" IsSelected="True"/>
                    <ComboBoxItem Content="Gemiddeld"/>
                    <ComboBoxItem Content="Moeilijk"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Feedback -->
        <Border Grid.Row="2" x:Name="FeedbackBorder"
                CornerRadius="8" Padding="14" Margin="0,12,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="TxtFeedback" TextWrapping="Wrap" FontSize="13"/>
        </Border>

        <!-- Knoppen -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Importeer"
                    Style="{StaticResource BtnPrimary}"
                    Height="42" Click="BtnImporteer_Click"/>
            <Button Grid.Column="1" Content="Sluiten"
                    Style="{StaticResource BtnSecondary}"
                    Height="42" Padding="20,10" Margin="8,0,0,0"
                    Click="BtnSluiten_Click"/>
        </Grid>
    </Grid>
</Window>
