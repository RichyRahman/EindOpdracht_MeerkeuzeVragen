<Window x:Class="MeerkeuzeVragenApp.UI.Views.ImportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Importeren" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0" Text="Data Importeren" FontSize="20"
                   FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Bestand kiezen -->
        <TextBlock Grid.Row="1" Text="Bestand:" Margin="0,0,0,5"/>
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtBestandspad" Grid.Column="0" IsReadOnly="True"
                     Padding="5" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Bladeren..." Width="90" Margin="10,0,0,0"
                    Click="BtnBladeren_Click"/>
        </Grid>

        <!-- Onderwerp -->
        <TextBlock Grid.Row="3" Text="Onderwerp naam:" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtOnderwerp" Grid.Row="4" Padding="5" Margin="0,0,0,15"/>

        <!-- Moeilijkheidsgraad -->
        <TextBlock Grid.Row="5" Text="Moeilijkheidsgraad:" Margin="0,0,0,5"/>
        <ComboBox x:Name="CmbMoeilijkheid" Grid.Row="6" Padding="5" 
                  Height="30" Margin="0,0,0,15">
            <ComboBoxItem Content="Makkelijk" IsSelected="True"/>
            <ComboBoxItem Content="Gemiddeld"/>
            <ComboBoxItem Content="Moeilijk"/>
        </ComboBox>

        <!-- Knoppen + feedback -->
        <StackPanel Grid.Row="7">
            <Button Content="Importeer" Height="40" FontSize="14"
                    Background="#2196F3" Foreground="White"
                    Click="BtnImporteer_Click"/>
            <TextBlock x:Name="TxtFeedback" Margin="0,10,0,0"
                       TextWrapping="Wrap" FontSize="12"/>
            <Button Content="Sluiten" Height="35" Margin="0,8,0,0"
                    Click="BtnSluiten_Click"/>
        </StackPanel>
    </Grid>
</Window>
