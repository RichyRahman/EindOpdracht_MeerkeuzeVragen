<Window x:Class="MeerkeuzeVragenApp.UI.Views.VraagBeheerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MeerkeuzeVragenApp.UI.Views"
        mc:Ignorable="d"
        Title="Vragen Beheren" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Vragen Beheren" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Voeg vragen toe of stel ze niet meer beschikbaar"
                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Filter balk -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}"
                CornerRadius="8" Padding="16,12"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Onderwerp:"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource TextSecondary}"/>
                <ComboBox x:Name="CmbOnderwerp" Grid.Column="1"
                          SelectionChanged="CmbOnderwerp_SelectionChanged"/>
                <CheckBox x:Name="ChkAlleenBeschikbaar" Grid.Column="3"
                          Content="Toon enkel beschikbare"
                          IsChecked="True" VerticalAlignment="Center"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            </Grid>
        </Border>

        <!-- Nieuwe vraag toevoegen -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}"
                CornerRadius="10" Padding="20"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="NIEUWE VRAAG TOEVOEGEN"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,12"/>

                <TextBox x:Name="TxtNieuweVraag" Grid.Row="1"
                         Height="38" VerticalContentAlignment="Center"
                         Margin="0,0,0,10"
                         xml:space="preserve">Vraagtekst...</TextBox>

                <!-- 4 antwoorden -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtAntwoordA" Grid.Column="0"
                             Height="38" VerticalContentAlignment="Center"
                             Margin="0,0,6,0">Antwoord A</TextBox>
                    <TextBox x:Name="TxtAntwoordB" Grid.Column="1"
                             Height="38" VerticalContentAlignment="Center"
                             Margin="0,0,6,0">Antwoord B</TextBox>
                    <TextBox x:Name="TxtAntwoordC" Grid.Column="2"
                             Height="38" VerticalContentAlignment="Center"
                             Margin="0,0,6,0">Antwoord C</TextBox>
                    <TextBox x:Name="TxtAntwoordD" Grid.Column="3"
                             Height="38" VerticalContentAlignment="Center">
                        Antwoord D</TextBox>
                </Grid>

                <!-- Correct + moeilijkheid + knop -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Correct:"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbCorrect" Grid.Column="1">
                        <ComboBoxItem Content="A" IsSelected="True"/>
                        <ComboBoxItem Content="B"/>
                        <ComboBoxItem Content="C"/>
                        <ComboBoxItem Content="D"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="Moeilijkheid:"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="12,0,8,0"/>
                    <ComboBox x:Name="CmbNieuweMoeilijkheid" Grid.Column="3">
                        <ComboBoxItem Content="Makkelijk" IsSelected="True"/>
                        <ComboBoxItem Content="Gemiddeld"/>
                        <ComboBoxItem Content="Moeilijk"/>
                    </ComboBox>

                    <Button Grid.Column="5" Content="➕  Vraag Toevoegen"
                            Style="{StaticResource BtnSuccess}"
                            Padding="16,8"
                            Click="BtnVoegVraagToe_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid x:Name="DgVragen" Grid.Row="3"
                  Margin="0,0,0,12" RowHeight="40">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding ID}" Width="60"/>
                <DataGridTextColumn Header="Vraag"
                                    Binding="{Binding Tekst}" Width="*"/>
                <DataGridTextColumn Header="Moeilijkheid"
                                    Binding="{Binding Moeilijkheidsgraad}"
                                    Width="110"/>
                <DataGridCheckBoxColumn Header="Beschikbaar"
                                        Binding="{Binding IsBeschikbaar}"
                                        Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Onderste balk -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="🚫  Stel Niet Beschikbaar"
                    Style="{StaticResource BtnDanger}"
                    Padding="16,10"
                    Click="BtnNietBeschikbaar_Click"/>

            <TextBlock x:Name="TxtFeedback" Grid.Column="1"
                       VerticalAlignment="Center" Margin="16,0"
                       FontSize="13"/>

            <Button Grid.Column="2" Content="Sluiten"
                    Style="{StaticResource BtnSecondary}"
                    Padding="20,10"
                    Click="BtnSluiten_Click"/>
        </Grid>
    </Grid>
</Window>
