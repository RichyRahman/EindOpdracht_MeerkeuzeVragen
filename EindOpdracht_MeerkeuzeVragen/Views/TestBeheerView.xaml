<Window x:Class="MeerkeuzeVragenApp.UI.Views.TestBeheerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test Opstellen" Height="650" Width="750"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Test Opstellen" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Genereer een nieuwe test of exporteer een bestaande"
                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Genereer formulier -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}"
                CornerRadius="10" Padding="20"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="NIEUWE TEST GENEREREN"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,16"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Testnaam:"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,10"/>
                <TextBox x:Name="TxtTestNaam" Grid.Row="1" Grid.Column="1"
                         Height="38" VerticalContentAlignment="Center"
                         Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Onderwerp:"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,10"/>
                <ComboBox x:Name="CmbOnderwerp" Grid.Row="2" Grid.Column="1"
                          Margin="0,0,0,10"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Aantal vragen:"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,16"/>
                <TextBox x:Name="TxtAantalVragen" Grid.Row="3" Grid.Column="1"
                         Height="38" VerticalContentAlignment="Center"
                         Text="10" Margin="0,0,0,16"/>

                <Button Grid.Row="4" Grid.Column="1"
                        Content="🎲  Genereer Test"
                        Style="{StaticResource BtnPrimary}"
                        HorizontalAlignment="Left" Padding="20,10"
                        Click="BtnGenereer_Click"/>
            </Grid>
        </Border>

        <!-- Gegenereerde test info -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}"
                CornerRadius="10" Padding="20"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="GEGENEREERDE TEST" FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtTestInfo"
                               Text="Nog geen test gegenereerd."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="13"/>
                </StackPanel>
                <Button x:Name="BtnExporteer" Grid.Column="1"
                        Content="💾  Exporteer naar .txt"
                        Style="{StaticResource BtnSuccess}"
                        Padding="16,10" IsEnabled="False"
                        Click="BtnExporteer_Click"/>
            </Grid>
        </Border>

        <!-- Bestaande testen -->
        <Border Grid.Row="3" Background="{StaticResource BgCard}"
                CornerRadius="10" Padding="20"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="BESTAANDE TESTEN"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,12"/>
                <DataGrid x:Name="DgTesten" Grid.Row="1" RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                            Binding="{Binding ID}" Width="60"/>
                        <DataGridTextColumn Header="Naam"
                            Binding="{Binding Naam}" Width="*"/>
                        <DataGridTextColumn Header="OnderwerpID"
                            Binding="{Binding OnderwerpID}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Onderste balk -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtFeedback" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="13"/>
            <Button Grid.Column="1" Content="Sluiten"
                    Style="{StaticResource BtnSecondary}"
                    Padding="20,10" Click="BtnSluiten_Click"/>
        </Grid>
    </Grid>
</Window>
