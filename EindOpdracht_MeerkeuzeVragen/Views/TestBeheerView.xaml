<Window x:Class="MeerkeuzeVragenApp.UI.Views.TestBeheerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MeerkeuzeVragenApp.UI.Views"
        mc:Ignorable="d"
        Title="Test Opstellen" Height="600" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0" Text="Test Opstellen" FontSize="20"
                   FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Test configuratie -->
        <GroupBox Grid.Row="1" Header="Nieuwe test genereren" 
                  Padding="10" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Testnaam:" 
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox x:Name="TxtTestNaam" Grid.Row="0" Grid.Column="1"
                         Padding="5" Height="32" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Onderwerp:"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <ComboBox x:Name="CmbOnderwerp" Grid.Row="1" Grid.Column="1"
                          Height="32" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Aantal vragen:"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox x:Name="TxtAantalVragen" Grid.Row="2" Grid.Column="1"
                         Padding="5" Height="32" Margin="0,0,0,10" Text="10"/>

                <Button Grid.Row="3" Grid.Column="1" Content="🎲 Genereer Test"
                        Height="38" HorizontalAlignment="Left" Width="180"
                        Background="#2196F3" Foreground="White"
                        Click="BtnGenereer_Click"/>
            </Grid>
        </GroupBox>

        <!-- Gegenereerde test preview -->
        <GroupBox Grid.Row="2" Header="Gegenereerde test" 
                  Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="TxtTestInfo" Text="Nog geen test gegenereerd."
                           Foreground="Gray" Margin="0,0,0,8"/>
                <Button x:Name="BtnExporteer" Content="💾 Exporteer naar .txt"
                        Height="35" HorizontalAlignment="Left" Width="200"
                        Background="#4CAF50" Foreground="White"
                        IsEnabled="False" Click="BtnExporteer_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Bestaande testen -->
        <GroupBox Grid.Row="3" Header="Bestaande testen" Padding="10">
            <DataGrid x:Name="DgTesten" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                    <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="*"/>
                    <DataGridTextColumn Header="OnderwerpID" 
                                        Binding="{Binding OnderwerpID}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Feedback + sluiten -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="TxtFeedback" VerticalAlignment="Center" FontSize="12"/>
            <Button Content="Sluiten" Height="35" Width="100"
                    Margin="20,0,0,0" Click="BtnSluiten_Click"/>
        </StackPanel>
    </Grid>
</Window>
