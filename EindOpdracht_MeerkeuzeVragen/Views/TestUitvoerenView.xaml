<Window x:Class="MeerkeuzeVragenApp.UI.Views.TestUitvoerenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test Uitvoeren" Height="650" Width="750"
        Background="#1E1E2E"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Test Uitvoeren" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Voer een test interactief uit of verwerk bulk antwoorden"
                       FontSize="12" Foreground="{StaticResource TextPrimary}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1"
                    Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource Border}">

            <!-- ── TAB 1: INTERACTIEF ── -->
            <TabItem Header="  Interactief  "
                     Foreground="{StaticResource TextPrimary}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Instellingen -->
                    <Border Grid.Row="0" Background="{StaticResource BgDark}"
                            CornerRadius="8" Padding="16"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Test:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbTest" Grid.Column="1"
                                      Margin="0,0,16,0"/>

                            <TextBlock Grid.Column="2" Text="Naam:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtGebruiker" Grid.Column="3"
                                     Height="38" VerticalContentAlignment="Center"
                                     Margin="0,0,12,0"/>

                            <Button Grid.Column="4" Content="▶  Start"
                                    Style="{StaticResource BtnPrimary}"
                                    Padding="16,8"
                                    Click="BtnStartTest_Click"/>
                        </Grid>
                    </Border>

                    <!-- Vraag weergave -->
                    <Border x:Name="GrpVraag" Grid.Row="1"
                            Background="{StaticResource BgDark}"
                            CornerRadius="10" Padding="20"
                            BorderBrush="{StaticResource Accent}"
                            BorderThickness="1" Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtVraagNummer"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtVraagTekst"
                                       TextWrapping="Wrap" FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,16"/>
                            <RadioButton x:Name="RbA" GroupName="Antwoord"
                                         Margin="0,0,0,8"/>
                            <RadioButton x:Name="RbB" GroupName="Antwoord"
                                         Margin="0,0,0,8"/>
                            <RadioButton x:Name="RbC" GroupName="Antwoord"
                                         Margin="0,0,0,8"/>
                            <RadioButton x:Name="RbD" GroupName="Antwoord"
                                         Margin="0,0,0,8"/>
                            <RadioButton x:Name="RbE" GroupName="Antwoord"
                                         Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Score & feedback -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border x:Name="ScoreBorder"
                                    Background="{StaticResource BgDark}"
                                    CornerRadius="10" Padding="20"
                                    Margin="0,0,0,12"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="TxtScore"
                                           FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <ItemsControl x:Name="LstFeedback">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#3D1515"
                                                BorderBrush="{StaticResource Danger}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,0,0,8" Padding="14">
                                            <TextBlock Text="{Binding}"
                                                       TextWrapping="Wrap"
                                                       FontSize="13"
                                                       Foreground="#FFCDD2"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Navigatie -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal"
                                Margin="0,12,0,0">
                        <Button x:Name="BtnVolgend"
                                Content="Volgende  ➡"
                                Style="{StaticResource BtnPrimary}"
                                Padding="20,10" Visibility="Collapsed"
                                Click="BtnVolgend_Click"/>
                        <Button x:Name="BtnIndienen"
                                Content="✅  Indienen"
                                Style="{StaticResource BtnSuccess}"
                                Padding="20,10" Margin="10,0,0,0"
                                Visibility="Collapsed"
                                Click="BtnIndienen_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ── TAB 2: BULK ── -->
            <TabItem Header="  Bulk Verwerking  "
                     Foreground="{StaticResource TextPrimary}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Instellingen -->
                    <Border Grid.Row="0" Background="{StaticResource BgDark}"
                            CornerRadius="8" Padding="16"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Test:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,10"/>
                            <ComboBox x:Name="CmbBulkTest"
                                      Grid.Row="0" Grid.Column="1"
                                      Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="CSV Bestand:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,10"/>
                            <Grid Grid.Row="1" Grid.Column="1"
                                  Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtBulkPad" Grid.Column="0"
                                         IsReadOnly="True" Height="38"
                                         VerticalContentAlignment="Center"
                                         Foreground="{StaticResource TextSecondary}"/>
                                <Button Grid.Column="1" Content="Bladeren"
                                        Style="{StaticResource BtnSecondary}"
                                        Padding="14,8" Margin="8,0,0,0"
                                        Click="BtnBulkBladeren_Click"/>
                            </Grid>

                            <Button Grid.Row="2" Grid.Column="1"
                                    Content="⚙  Verwerk Bulk"
                                    Style="{StaticResource BtnWarning}"
                                    HorizontalAlignment="Left"
                                    Padding="16,8"
                                    Click="BtnVerwerkBulk_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="TxtBulkFeedback" Grid.Row="1"
                               Margin="0,0,0,10" FontSize="13"/>

                    <DataGrid x:Name="DgBulkResultaten" Grid.Row="2"
                              RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GebruikerID"
                                Binding="{Binding GebruikerID}" Width="130"/>
                            <DataGridTextColumn Header="Score"
                                Binding="{Binding Score}" Width="80"/>
                            <DataGridTextColumn Header="Resultaat"
                                Binding="{Binding Resultaat}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="3" Content="Sluiten"
                            Style="{StaticResource BtnSecondary}"
                            HorizontalAlignment="Left"
                            Padding="20,10" Margin="0,12,0,0"
                            Click="BtnSluiten_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Sluiten"
                Style="{StaticResource BtnSecondary}"
                HorizontalAlignment="Left"
                Padding="20,10" Margin="0,12,0,0"
                Click="BtnSluiten_Click"/>
    </Grid>
</Window>
